# Autolab staging environment example.
# Copy to a private .env file or configure these in Render/hosting dashboard.
# Do not point VITE_APP_URL or DNS at the current Manus production site.

NODE_ENV=production
VITE_APP_TITLE=AI峰哥官方網站 Staging
VITE_APP_URL=https://autolab-staging.example.com

DATABASE_URL=postgresql://username:password@ep-staging-region.aws.neon.tech/neondb?sslmode=require

# Schema writes should be enabled only in the shell command that applies db:push:staging.
ALLOW_STAGING_SCHEMA_PUSH=false
STAGING_DB_CONFIRM=

CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
ADMIN_USER_IDS=user_xxxxx
JWT_SECRET=replace_with_random_value_at_least_32_characters

RESEND_API_KEY=re_xxxxx
EMAIL_FROM=noreply@staging.example.com

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=autolab-assets-staging
R2_PUBLIC_URL=

GEMINI_API_KEY=

NEWEBPAY_MERCHANT_ID=
NEWEBPAY_HASH_KEY=
NEWEBPAY_HASH_IV=
NEWEBPAY_API_URL=https://ccore.newebpay.com/MPG/mpg_gateway

TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

VITE_GOOGLE_MAPS_API_KEY=

MAKE_WEBHOOK_URL=
ACCOUNTING_WEBHOOK_URL=
ACCOUNTING_WEBHOOK_ENABLED=false

VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
